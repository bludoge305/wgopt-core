#include <winres.h>

1 ICON "wgopt.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "WGOpt"
            VALUE "FileDescription",  "WGOpt 游戏优化后台程序"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "wgopt"
            VALUE "LegalCopyright",   "WGOpt"
            VALUE "OriginalFilename", "wgopt.exe"
            VALUE "ProductName",      "WGOpt"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
